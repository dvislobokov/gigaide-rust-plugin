<idea-plugin>
    <id>io.github.rustsupport</id>
    <name>Rust Support</name>
    <vendor>dvislobokov</vendor>

    <description><![CDATA[
        Rust support for IntelliJ-based IDEs that have none, built on the tools of the Rust ecosystem:
        <ul>
            <li><b>rust-analyzer</b> for errors, completion, navigation, refactorings, inlay hints and semantic highlighting (the LSP client of the platform)</li>
            <li>syntax highlighting by the Rust grammar the IDE bundles (TextMate)</li>
            <li><b>rustup</b>: missing components installed from the IDE</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- RustRover, or the JetBrains Rust plugin: nothing this plugin could add -->
    <incompatible-with>com.jetbrains.rust</incompatible-with>

    <!-- optional parts: a module is loaded only where its dependencies are (see the descriptor of the module next to META-INF) -->
    <content>
        <module name="io.github.rustsupport.lsp"/>
    </content>

    <!-- ===== Stage 3: running with Cargo ===== -->
    <extensionPoints>
        <!-- the runnables of a file, from rust-analyzer in the content module io.github.rustsupport.lsp -->
        <extensionPoint qualifiedName="io.github.rustsupport.runnableSource" interface="io.github.rustsupport.run.RustRunnableSource" dynamic="true"/>
    </extensionPoints>
    <!-- ===== end of Stage 3 ===== -->

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Rust" displayType="BALLOON"/>
        <!-- target/ of every Cargo package out of the index and the search -->
        <directoryIndexExcludePolicy implementation="io.github.rustsupport.toolchain.RustExcludePolicy"/>
        <!-- the default JDK the IDE gives a directory it opens, off a Rust project without Java -->
        <postStartupActivity implementation="io.github.rustsupport.toolchain.RustProjectSdkCleaner"/>
        <!-- the tools on PATH / in ~/.cargo/bin, whether they run, rust-src, MSVC: one balloon with the fixes when something is missing -->
        <postStartupActivity implementation="io.github.rustsupport.toolchain.RustToolchainCheckActivity"/>
        <fileIconProvider implementation="io.github.rustsupport.RustFileIconProvider" order="first"/>

        <!-- Rust as a language of the plugin: a lexer without a grammar (structure, errors and resolve are rust-analyzer's) -->
        <fileType name="Rust" implementationClass="io.github.rustsupport.lang.RustFileType" fieldName="INSTANCE" language="Rust" extensions="rs"/>
        <lang.parserDefinition language="Rust" implementationClass="io.github.rustsupport.lang.RustParserDefinition"/>
        <lang.syntaxHighlighterFactory language="Rust" implementationClass="io.github.rustsupport.lang.RustSyntaxHighlighterFactory"/>
        <lang.braceMatcher language="Rust" implementationClass="io.github.rustsupport.lang.RustBraceMatcher"/>
        <lang.commenter language="Rust" implementationClass="io.github.rustsupport.lang.RustCommenter"/>
        <lang.quoteHandler language="Rust" implementationClass="io.github.rustsupport.lang.RustQuoteHandler"/>
        <lineIndentProvider implementation="io.github.rustsupport.lang.RustLineIndentProvider"/>
        <enterHandlerDelegate implementation="io.github.rustsupport.lang.RustEnterBetweenBracketsHandler"/>
        <!-- Enter in `///`, `//!` and inside the text of `//` continues the comment (by the lexer: no wait for the server) -->
        <enterHandlerDelegate implementation="io.github.rustsupport.lang.RustCommentEnterHandler"/>
        <colorSettingsPage implementation="io.github.rustsupport.lang.RustColorSettingsPage"/>
        <applicationConfigurable parentId="language" instance="io.github.rustsupport.settings.RustSettingsConfigurable"
                                 id="io.github.rustsupport.settings" displayName="Rust"/>
        <!-- ===== Stage 3: running with Cargo (io.github.rustsupport.run) ===== -->
        <configurationType implementation="io.github.rustsupport.run.CargoConfigurationType"/>
        <runConfigurationProducer implementation="io.github.rustsupport.run.CargoRunConfigurationProducer"/>
        <!-- the runnables of rust-analyzer (experimental/runnables), else fn main of a binary -->
        <runLineMarkerContributor language="Rust" implementationClass="io.github.rustsupport.run.CargoRunLineMarkerContributor"/>
        <!-- file.rs:10:5 of the compiler, of panics and backtraces as links in every console -->
        <consoleFilterProvider implementation="io.github.rustsupport.run.CargoConsoleFilterProvider"/>
        <!-- ===== end of Stage 3 ===== -->
    </extensions>

    <actions>
        <group id="Rust.ToolsMenu" text="Rust" popup="true" icon="/icons/rustToolWindow.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="Rust.CheckToolchain" class="io.github.rustsupport.toolchain.CheckRustToolchainAction" text="Check Toolchain"
                    icon="AllIcons.Actions.Checked" description="Look at cargo, rustc, rust-analyzer, rustfmt, clippy, rust-src and the MSVC linker"/>
            <action id="Rust.InstallComponents" class="io.github.rustsupport.settings.InstallRustComponentsAction" text="Install or Update Components"
                    icon="AllIcons.Actions.Download" description="rustup component add rust-analyzer rust-src rustfmt clippy"/>
            <!-- ===== Stage 3: cargo commands of the project ===== -->
            <separator/>
            <action id="Rust.CargoBuild" class="io.github.rustsupport.run.CargoBuildAction" text="Cargo Build"
                    icon="AllIcons.Actions.Compile" description="cargo build of the project, in a Run console"/>
            <action id="Rust.CargoCheck" class="io.github.rustsupport.run.CargoCheckAction" text="Cargo Check"
                    description="cargo check of the project, in a Run console"/>
            <action id="Rust.CargoClippy" class="io.github.rustsupport.run.CargoClippyAction" text="Cargo Clippy"
                    description="cargo clippy of the project, in a Run console"/>
            <!-- ===== end of Stage 3 ===== -->
            <separator/>
            <action id="Rust.Settings" class="io.github.rustsupport.settings.OpenRustSettingsAction" text="Settings..."
                    icon="AllIcons.General.Settings" description="Settings | Languages &amp; Frameworks | Rust"/>
        </group>
        <!-- ===== Stage 3: the same cargo commands in the Build menu ===== -->
        <group id="Rust.CargoBuildMenu">
            <add-to-group group-id="BuildMenu" anchor="last"/>
            <separator/>
            <reference ref="Rust.CargoBuild"/>
            <reference ref="Rust.CargoCheck"/>
            <reference ref="Rust.CargoClippy"/>
        </group>
        <!-- ===== end of Stage 3 ===== -->
    </actions>

    <!-- ===== Debugger (package io.github.rustsupport.debugger): the plugin's own DAP client to CodeLLDB on the XDebugger API ===== -->
    <!-- GIGA IDE has no intellij.platform.dap; CodeLLDB is found (settings, VS Code / Cursor / VSCodium extension, downloads) or offered -->
    <extensions defaultExtensionNs="com.intellij">
        <programRunner implementation="io.github.rustsupport.debugger.RustDebugRunner"/>
        <xdebugger.breakpointType implementation="io.github.rustsupport.debugger.RustLineBreakpointType"/>
        <xdebugger.breakpointType implementation="io.github.rustsupport.debugger.RustPanicBreakpointType"/>
        <applicationConfigurable parentId="io.github.rustsupport.settings" instance="io.github.rustsupport.debugger.RustDebuggerConfigurable"
                                 id="io.github.rustsupport.settings.debugger" displayName="Debugger"/>
        <registryKey key="rust.debugger.protocol.trace" defaultValue="false"
                     description="Write every DAP message of the Rust debug sessions into the log directory, rust-debugger/"/>
    </extensions>
    <actions>
        <action id="Rust.DownloadCodeLldb" class="io.github.rustsupport.debugger.DownloadCodeLldbAction">
            <add-to-group group-id="Rust.ToolsMenu" anchor="last"/>
        </action>
    </actions>
    <!-- ===== end of Debugger ===== -->

    <!-- ===== Rust Monitor ===== -->
    <!-- CPU, memory, threads and processes of the program a Cargo run started (package io.github.rustsupport.monitor) -->
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Rust Monitor" anchor="right" icon="/icons/rustMonitor.svg" doNotActivateOnStart="true"
                    factoryClass="io.github.rustsupport.monitor.RustMonitorToolWindowFactory"/>
    </extensions>
    <actions>
        <action id="Rust.OpenMonitor" class="io.github.rustsupport.monitor.OpenRustMonitorAction" text="Open Monitor" icon="/icons/rustMonitor.svg"
                description="CPU, memory and threads of the program a Cargo run started">
            <add-to-group group-id="Rust.ToolsMenu" anchor="before" relative-to-action="Rust.Settings"/>
            <add-to-group group-id="ConsoleEditorPopupMenu" anchor="last"/>
        </action>
    </actions>
    <projectListeners>
        <listener class="io.github.rustsupport.monitor.RustProcessStartListener" topic="com.intellij.execution.ExecutionListener"/>
    </projectListeners>
    <!-- end of Rust Monitor -->

    <!-- ===== Templates, rustfmt on save, Explain Error ===== -->
    <!-- live and postfix templates by the tokens (io.github.rustsupport.lang), rustfmt on save and rustc explain (io.github.rustsupport.toolchain);
         "Explain E0308" on the diagnostics of rust-analyzer is RustAnalyzerDiagnosticsSupport of the content module -->
    <extensions defaultExtensionNs="com.intellij">
        <liveTemplateContext contextId="RUST" implementation="io.github.rustsupport.lang.RustTemplateContext"/>
        <liveTemplateContext contextId="RUST_ITEM" baseContextId="RUST" implementation="io.github.rustsupport.lang.RustItemTemplateContext"/>
        <liveTemplateContext contextId="RUST_CODE" baseContextId="RUST" implementation="io.github.rustsupport.lang.RustCodeTemplateContext"/>
        <defaultLiveTemplates file="/liveTemplates/Rust.xml"/>
        <codeInsight.template.postfixTemplateProvider language="Rust" implementationClass="io.github.rustsupport.lang.RustPostfixTemplateProvider"/>
        <actionOnSave implementation="io.github.rustsupport.toolchain.RustfmtOnSave"/>
        <actionOnSaveInfoProvider implementation="io.github.rustsupport.toolchain.RustfmtOnSaveInfoProvider"/>
    </extensions>
    <actions>
        <action id="Rust.ExplainErrorCode" class="io.github.rustsupport.toolchain.ExplainRustErrorCodeAction" text="Explain Rust Error Code..."
                icon="AllIcons.Actions.Help" description="rustc --explain of an error code such as E0308, in an editor tab">
            <add-to-group group-id="Rust.ToolsMenu" anchor="before" relative-to-action="Rust.Settings"/>
        </action>
    </actions>
    <!-- end of Templates, rustfmt on save, Explain Error -->
</idea-plugin>
