      <option name="RUST_CODE" value="true"/>
    </context>
  </template>
  <template name="loop" value="loop {&#10;    $END$&#10;}" description="An infinite loop" toReformat="false" toShortenFQNames="false">
    <context>
      <option name="RUST_CODE" value="true"/>
    </context>
  </template>
  <template name="todo" value="todo!()$END$" description="todo!(): not implemented yet" toReformat="false" toShortenFQNames="false">
    <context>
      <option name="RUST_CODE" value="true"/>
    </context>
  </template>
  <template name="unimpl" value="unimplemented!()$END$" description="unimplemented!()" toReformat="false" toShortenFQNames="false">
    <context>
      <option name="RUST_CODE" value="true"/>
    </context>
  </template>

  <!--
    Named by the keyword itself: completion offers a live template whose name is the whole word typed, so `struct` shows
    `struct … { }` in the popup next to the keyword of rust-analyzer (Enter or Tab expands it). The caret goes to an empty name first.
  -->
  <template name="struct" value="struct $NAME$ {&#10;    $END$&#10;}" description="struct Name { fields }" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="" alwaysStopAt="true"/>
    <context>
      <option name="RUST_ITEM" value="true"/>
      <option name="RUST_CODE" value="true"/>
    </context>
  </template>
  <template name="structt" value="struct $NAME$($FIELDS$);$END$" description="struct Name(fields): a tuple struct" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="" alwaysStopAt="true"/>
    <variable name="FIELDS" expression="" defaultValue="" alwaysStopAt="true"/>
    <context>
      <option name="RUST_ITEM" value="true"/>
      <option name="RUST_CODE" value="true"/>
    </context>
  </template>
  <template name="enum" value="enum $NAME$ {&#10;    $END$&#10;}" description="enum Name { variants }" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="" alwaysStopAt="true"/>
    <context>
      <option name="RUST_ITEM" value="true"/>
      <option name="RUST_CODE" value="true"/>
    </context>
  </template>
  <template name="trait" value="trait $NAME$ {&#10;    $END$&#10;}" description="trait Name { items }" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="" alwaysStopAt="true"/>
