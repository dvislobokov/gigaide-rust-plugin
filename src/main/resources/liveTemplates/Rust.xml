  </template>
  <template name="for" value="for $X$ in $ITER$ {&#10;    $END$&#10;}" description="A for loop" toReformat="false" toShortenFQNames="false">
    <variable name="X" expression="" defaultValue='"x"' alwaysStopAt="true"/>
    <variable name="ITER" expression="" defaultValue='"iter"' alwaysStopAt="true"/>
