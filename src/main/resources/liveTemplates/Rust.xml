    <context>
      <option name="RUST_ITEM" value="true"/>
      <option name="RUST_CODE" value="true"/>
    </context>
  </template>
  <template name="implfor" value="impl $TRAIT$ for $TYPE$ {&#10;    $END$&#10;}" description="impl Trait for Type { items }" toReformat="false" toShortenFQNames="false">
    <variable name="TRAIT" expression="" defaultValue="" alwaysStopAt="true"/>
    <variable name="TYPE" expression="" defaultValue="" alwaysStopAt="true"/>
    <context>
      <option name="RUST_ITEM" value="true"/>
      <option name="RUST_CODE" value="true"/>
    </context>
  </template>
  <template name="new" value="pub fn new($PARAMS$) -&gt; Self {&#10;    Self { $END$ }&#10;}" description="pub fn new(..) -> Self: a constructor" toReformat="false" toShortenFQNames="false">
    <variable name="PARAMS" expression="" defaultValue="" alwaysStopAt="true"/>
    <context>
      <option name="RUST_ITEM" value="true"/>
    </context>
  </template>
  <template name="mod" value="mod $NAME$ {&#10;    $END$&#10;}" description="mod name { items }" toReformat="false" toShortenFQNames="false">
