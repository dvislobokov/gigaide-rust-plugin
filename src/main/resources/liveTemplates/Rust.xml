  <template name="macro_rules" value="macro_rules! $NAME$ {&#10;    ($PATTERN$) =&gt; {&#10;        $END$&#10;    };&#10;}" description="macro_rules! name { (pattern) => { expansion }; }" toReformat="false" toShortenFQNames="false">
