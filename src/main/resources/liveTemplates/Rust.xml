    </context>
  </template>
  <template name="const" value="const $NAME$: $TYPE$ = $END$;" description="const NAME: Type = value;" toReformat="false" toShortenFQNames="false">
    <variable name="NAME" expression="" defaultValue="" alwaysStopAt="true"/>
